#include "i2c_config.dtsi"
#include <zephyr/dt-bindings/regulator/npm10xx.h>

&pmic_i2c {
	npm1012: pmic@6a {
		reg = <0x6a>;
		compatible = "nordic,npm10xx";

		npm1012_charger: charger {
			compatible = "nordic,npm10xx-charger";
			/* UICR programming requires highest VBUS current limit */
			vbus-limit-microamp = <300000>;
		};

		npm1012_uicr: otp {
			compatible = "nordic,npm10xx-uicr";
		};
	};
};
